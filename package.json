{
  "name": "expense-tracker-fullstack",
  "version": "1.0.0",
  "description": "A full-stack Expense Tracker with budget management and analysis",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "nodemon --exec node --loader tsx src/server/index.ts",
    "dev:client": "cd client && npm run dev",
    "build": "tsc && cd client && npm run build",
    "start": "node dist/server/index.js",
    "seed": "node --loader tsx src/server/seed.ts"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "jsonwebtoken": "^9.1.0",
    "bcryptjs": "^2.4.3",
    "sqlite3": "^5.1.6",
    "sql.js": "^1.8.0",
    "zod": "^3.22.4",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.20",
    "@types/node": "^20.8.0",
    "@types/jsonwebtoken": "^9.0.4",
    "@types/bcryptjs": "^2.4.2",
    "typescript": "^5.2.2",
    "tsx": "^3.14.0",
    "nodemon": "^3.0.1",
    "concurrently": "^8.2.1"
  }
}
